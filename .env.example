# MarketMind AI - Small Business Sales Intelligence Platform
PROJECT_NAME="MarketMind AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketmind_db
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/marketmind_db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
